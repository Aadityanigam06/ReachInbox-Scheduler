generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())

  campaigns EmailCampaign[]
  emails    Email[]
  scheduleRequests EmailScheduleRequest[]
  slack     SlackConnection?
}

model EmailCampaign {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  body        String
  startTime   DateTime?
  delayMs     Int      @default(0)
  hourlyLimit Int?
  createdAt   DateTime @default(now())

  emails Email[]
  scheduleRequests EmailScheduleRequest[]

  @@index([userId])
}

model Email {
  id             String      @id @default(uuid())
  campaignId     String?
  userId         String
  recipient      String
  subject        String
  body           String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus @default(SCHEDULED)
  attempts       Int         @default(0)
  messageId      String?
  previewUrl     String?
  error          String?
  idempotencyKey String      @unique
  scheduleRequestId String?
  delayMs        Int         @default(0)
  hourlyLimit    Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  scheduleRequest EmailScheduleRequest? @relation(fields: [scheduleRequestId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
  @@index([idempotencyKey])
}

model EmailScheduleRequest {
  id             String   @id @default(uuid())
  userId         String
  campaignId     String
  idempotencyKey String
  requestHash    String
  queuedAt       DateTime?
  createdAt      DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id])
  campaign EmailCampaign @relation(fields: [campaignId], references: [id])
  emails   Email[]

  @@unique([userId, idempotencyKey])
  @@index([campaignId])
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  webhookUrl  String?
  token       String?
  connected   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}
